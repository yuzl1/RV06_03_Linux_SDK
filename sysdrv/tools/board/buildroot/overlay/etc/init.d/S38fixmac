#!/bin/sh
#
# 固定 eth0 MAC 地址，防止刷机后 IP 变化
# S38 = 在网络启动(S40)之前
#

FIXED_MAC="38:7a:cc:ff:ee:01"

# 如果 MAC 不是固定的那个，就改掉
current=$(ip link show eth0 2>/dev/null | grep ether | awk '{print $2}')
if [ -n "$current" ] && [ "$current" != "$FIXED_MAC" ]; then
    echo "Fixing eth0 MAC: $current -> $FIXED_MAC"
    ip link set eth0 down
    ip link set eth0 address "$FIXED_MAC"
    ip link set eth0 up
fi
