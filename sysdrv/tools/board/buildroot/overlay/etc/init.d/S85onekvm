#!/bin/sh
#
# One-KVM IP-KVM Service for LubanCat-RV06 Buildroot
# S85 = 在网络/SSH 之后启动
#

BIN=/usr/bin/one-kvm
LIB_DIR=/usr/lib/one-kvm-libs
LD_SO=$LIB_DIR/ld-linux-armhf.so.3
DATA_DIR=/var/lib/one-kvm
PID_FILE=/var/run/one-kvm.pid
LOG_FILE=/var/log/one-kvm.log

export LD_LIBRARY_PATH=$LIB_DIR
export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

start() {
    echo "Starting One-KVM..."
    mkdir -p $DATA_DIR

    # 直接后台启动，不依赖 start-stop-daemon（busybox 版本功能有限）
    $LD_SO $BIN -d $DATA_DIR -p 8080 -l info >> $LOG_FILE 2>&1 &
    echo $! > $PID_FILE
    echo "One-KVM started (PID $(cat $PID_FILE))"
}

stop() {
    echo "Stopping One-KVM..."
    if [ -f $PID_FILE ]; then
        kill $(cat $PID_FILE) 2>/dev/null
        rm -f $PID_FILE
    fi
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) restart ;;
    *)       echo "Usage: $0 {start|stop|restart}" ;;
esac
